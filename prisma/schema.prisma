generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               Int         @id @default(autoincrement())
  title            String
  category         String?
  zone             String?
  deliveryDate     String?     @map("delivery_date")
  coastline        String?
  seaDistance      String?     @map("sea_distance")
  buildingCount    String?     @map("building_count")
  floorCount       String?     @map("floor_count")
  area             String?
  apartmentCount   String?     @map("apartment_count")
  parkingSpaces    String?     @map("parking_spaces")
  repairStatus     String?     @map("repair_status")
  apartmentFormats String?     @map("apartment_formats") @db.Text
  apartmentAreas   String?     @map("apartment_areas") @db.Text
  areaRange        String?     @map("area_range")
  pricePerM2       String?     @map("price_per_m2")
  totalPrice       String?     @map("total_price")
  bankMortgage     String?     @map("bank_mortgage")
  internalCredit   String?     @map("internal_credit")
  downPayment      String?     @map("down_payment")
  infrastructure   String?     @db.Text
  features         String?     @db.Text
  description      String?     @db.Text
  imageUrl         String?     @map("image_url") @db.Text
  images           Json?
  displayOrder     Int?        @map("display_order")
  slug             String?     @unique
  featuredInHero   Boolean     @default(false) @map("featured_in_hero")
  isArchived       Boolean     @default(false) @map("is_archived")
  pdfUrl           String?     @map("pdf_url") @db.Text
  pdfFilename      String?     @map("pdf_filename") @db.Text
  brochureUrl      String?     @map("brochure_url") @db.Text
  brochureFilename String?     @map("brochure_filename") @db.Text
  viewCount        Int         @default(0) @map("view_count")
  clickCount       Int         @default(0) @map("click_count")
  inquiryCount     Int         @default(0) @map("inquiry_count")
  createdAt        DateTime    @default(now()) @map("created_at")
  heroSlides       HeroSlide[]
  inquiries        ProjectInquiry[]

  @@index([displayOrder, id])
  @@index([isArchived], map: "idx_projects_is_archived")
  @@map("projects")
}

model ProjectInquiry {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String
  phone     String
  note      String?  @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_project_inquiries_project_id")
  @@index([status, createdAt], map: "idx_project_inquiries_status_created")
  @@map("project_inquiries")
}

model Listing {
  id                   BigInt         @id @default(autoincrement())
  title                String
  listingType          String?        @map("listing_type")
  propertyCategory     String?        @map("property_category")
  propertySubtype      String?        @map("property_subtype")
  projectName          String?        @map("project_name")
  regionType           String?        @map("region_type")
  city                 String?
  district             String?
  settlement           String?
  neighborhood         String?
  metroStation         String?        @map("metro_station")
  streetAddress        String?        @map("street_address") @db.Text
  latitude             Float?
  longitude            Float?
  roomCount            Int?           @map("room_count")
  area                 String?
  floorNumber          Int?           @map("floor_number")
  floorCount           String?        @map("floor_count")
  price                Decimal?       @db.Decimal(14, 2)
  pricePerM2           Decimal?       @map("price_per_m2") @db.Decimal(12, 2)
  currency             String         @default("AZN")
  isCredit             Boolean        @default(false) @map("is_credit")
  ownerType            String         @default("owner") @map("owner_type")
  hasDocument          Boolean        @default(false) @map("has_document")
  creditDownPayment    Decimal?       @map("credit_down_payment") @db.Decimal(14, 2)
  creditMonthlyPayment Decimal?       @map("credit_monthly_payment") @db.Decimal(14, 2)
  creditYears          Int?           @map("credit_years")
  imageUrl             String?        @map("image_url") @db.Text
  description          String?        @db.Text
  displayOrder         Int?           @map("display_order")
  listingCode          BigInt?        @unique @map("listing_code")
  createdAt            DateTime       @default(now()) @map("created_at")
  userId               BigInt?        @map("user_id")
  status               String         @default("pending")
  approvedAt           DateTime?      @map("approved_at")
  approvedBy           BigInt?        @map("approved_by")
  viewCount            Int            @default(0) @map("view_count")
  favoritesCount       Int            @default(0) @map("favorites_count")
  featured             Boolean        @default(false)
  vip                  Boolean        @default(false)
  images               ListingImage[]
  views                ListingView[]
  favorites            Favorite[]
  listingHeroItems     ListingHeroItem[]
  conversations        Conversation[]

  @@index([displayOrder, id])
  @@index([status], map: "idx_listings_status")
  @@map("listings")
}

model ListingHeroItem {
  id                Int      @id @default(autoincrement())
  listingId         BigInt   @map("listing_id")
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  badgeText         String?  @map("badge_text")
  createdAt         DateTime @default(now()) @map("created_at")
  slideDuration     Int      @default(10) @map("slide_duration")
  customTitle       String?  @map("custom_title")
  customDescription String?  @map("custom_description") @db.Text
  heroMediaUrl      String?  @map("hero_media_url") @db.Text
  listing           Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder, id], map: "idx_listing_hero_items_active_order")
  @@map("listing_hero_items")
}

model ListingView {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  userId    BigInt?  @map("user_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId], map: "idx_listing_views_listing_id")
  @@index([viewedAt], map: "idx_listing_views_viewed_at")
  @@map("listing_views")
}

model Favorite {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  listingId BigInt   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId], map: "idx_favorites_user_id")
  @@index([listingId], map: "idx_favorites_listing_id")
  @@map("favorites")
}

model ListingImage {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  imageUrl  String   @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String?  @db.Text
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  link      String?  @db.Text
  imageUrl  String?  @map("image_url") @db.Text
  videoUrl  String?  @map("video_url") @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt], map: "idx_notifications_user_read_created")
  @@index([type], map: "idx_notifications_type")
  @@map("notifications")
}

model Conversation {
  id           BigInt        @id @default(autoincrement())
  listingId    BigInt?       @map("listing_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants Participant[]
  messages     Message[]

  @@index([listingId], map: "idx_conversations_listing_id")
  @@index([updatedAt], map: "idx_conversations_updated_at")
  @@map("conversations")
}

model Participant {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  userId         Int          @map("user_id")
  hiddenAt       DateTime?    @map("hidden_at")
  clearedAt      DateTime?    @map("cleared_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId], map: "participants_conversation_user_unique")
  @@index([userId], map: "idx_participants_user_id")
  @@map("participants")
}

model Message {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  senderId       Int          @map("sender_id")
  receiverId     Int          @map("receiver_id")
  text           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  isRead         Boolean      @default(false) @map("is_read")
  deliveredAt    DateTime?    @map("delivered_at")
  readAt         DateTime?    @map("read_at")
  deletedAt      DateTime?    @map("deleted_at")
  deletedById    Int?         @map("deleted_by_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "idx_messages_conversation_created")
  @@index([receiverId, isRead], map: "idx_messages_receiver_read")
  @@index([senderId], map: "idx_messages_sender_id")
  @@map("messages")
}

model Vacancy {
  id             Int           @id @default(autoincrement())
  title          String
  employmentType String?       @map("employment_type")
  salary         String?
  city           String?
  description    String?       @db.Text
  isActive       Boolean       @default(true) @map("is_active")
  slug           String?       @unique
  createdAt      DateTime      @default(now()) @map("created_at")
  applications   Application[]

  @@map("vacancies")
}

model Application {
  id        Int      @id @default(autoincrement())
  fullname  String
  phone     String?
  vacancyId Int?     @map("vacancy_id")
  cvFile    String?  @map("cv_file") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@map("applications")
}

model Gallery {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?   @db.Text
  mediaType      MediaType @map("media_type")
  imageUrl       String?   @map("image_url") @db.Text
  videoUrl       String?   @map("video_url") @db.Text
  thumbnailUrl   String?   @map("thumbnail_url") @db.Text
  mediaUrls      Json?     @map("media_urls")
  images         Json?
  mediaPositionX String    @default("center") @map("media_position_x")
  mediaPositionY String    @default("center") @map("media_position_y")
  sortOrder      Int       @default(0) @map("sort_order")
  isFeatured     Boolean   @default(false) @map("is_featured")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([sortOrder, id])
  @@index([mediaType, isFeatured, sortOrder, id], map: "idx_gallery_featured_videos")
  @@map("gallery")
}

model User {
  id            Int               @id @default(autoincrement())
  fullname      String
  email         String            @unique
  passwordHash  String?           @map("password_hash")
  phone         String?           @db.Text
  avatarUrl     String?           @map("avatar_url") @db.Text
  provider      String            @default("local")
  googleId      String?           @unique @map("google_id")
  bio           String?           @db.Text
  isActive      Boolean           @default(true) @map("is_active")
  emailVerified Boolean           @default(true) @map("email_verified")
  phoneVerified Boolean           @default(false) @map("phone_verified")
  lastLogin     DateTime?         @map("last_login")
  lastLoginIp   String?           @map("last_login_ip") @db.Text
  lastLoginUserAgent String?      @map("last_login_user_agent") @db.Text
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil   DateTime?         @map("locked_until")
  role          Role              @default(user)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")
  sessions      UserSession[]
  activityLogs  UserActivityLog[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeTokens      EmailChangeToken[]
  notifications          Notification[]
  conversations          Participant[]
  sentMessages           Message[] @relation("SentMessages")
  receivedMessages       Message[] @relation("ReceivedMessages")

  @@index([lockedUntil], map: "idx_users_locked_until")
  @@map("users")
}

model EmailVerificationToken {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_verification_tokens_user_id")
  @@index([expiresAt], map: "idx_email_verification_tokens_expires_at")
  @@index([used], map: "idx_email_verification_tokens_used")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Text
  email     String   @db.Text
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}


model EmailChangeToken {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.Text
  newEmail  String   @map("new_email")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_change_tokens_user_id")
  @@index([newEmail], map: "idx_email_change_tokens_new_email")
  @@index([expiresAt], map: "idx_email_change_tokens_expires_at")
  @@index([used], map: "idx_email_change_tokens_used")
  @@map("email_change_tokens")
}

model UserSession {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.Text
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([expiresAt], map: "idx_user_sessions_expires_at")
  @@map("user_sessions")
}

model UserActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_activity_logs_user_id")
  @@index([action], map: "idx_user_activity_logs_action")
  @@index([createdAt], map: "idx_user_activity_logs_created_at")
  @@map("user_activity_logs")
}

model HeroSection {
  id               String   @id @default(uuid()) @db.Uuid
  pageKey          String   @unique @map("page_key")
  badgeText        String?  @map("badge_text")
  title            String?
  description      String?  @db.Text
  heroImageUrl     String?  @map("hero_image_url") @db.Text
  badgeColor       String?  @default("#7F7FFF") @map("badge_color")
  titleColor       String?  @default("#111827") @map("title_color")
  descriptionColor String?  @default("#374151") @map("description_color")
  overlayColor     String?  @default("#000000") @map("overlay_color")
  overlayOpacity   Decimal? @default(0.35) @map("overlay_opacity") @db.Decimal(3, 2)
  buttonColor      String?  @default("#7F7FFF") @map("button_color")
  buttonTextColor  String?  @default("#FFFFFF") @map("button_text_color")
  isActive         Boolean  @default(true) @map("is_active")

  @@map("hero_sections")
}

model HeroSlide {
  id                  Int      @id @default(autoincrement())
  title               String
  description         String?  @db.Text
  slideType           String   @default("custom") @map("slide_type")
  projectId           Int?     @map("project_id")
  mediaType           String   @default("image") @map("media_type")
  mediaUrl            String   @map("media_url") @db.Text
  badgeText           String?  @map("badge_text")
  badgeColor          String?  @default("#FFFFFF") @map("badge_color")
  badgeBackground     String?  @default("rgba(127,127,255,0.92)") @map("badge_background")
  titleColor          String?  @default("#FFFFFF") @map("title_color")
  titleFontSize       Int      @default(48) @map("title_font_size")
  descriptionColor    String?  @default("#F8FAFC") @map("description_color")
  descriptionFontSize Int      @default(18) @map("description_font_size")
  buttonColor         String?  @default("#7F7FFF") @map("button_color")
  buttonTextColor     String?  @default("#FFFFFF") @map("button_text_color")
  panelBackground     String?  @default("#111827") @map("panel_background")
  panelBlur           Int      @default(18) @map("panel_blur")
  panelOpacity        Int      @default(72) @map("panel_opacity")
  panelPosition       String   @default("bottom-center") @map("panel_position")
  heroHeightDesktop   Int      @default(560) @map("hero_height_desktop")
  heroHeightTablet    Int      @default(420) @map("hero_height_tablet")
  heroHeightMobile    Int      @default(320) @map("hero_height_mobile")
  buttonText          String?  @map("button_text")
  buttonLink          String?  @map("button_link") @db.Text
  displayOrder        Int      @default(0) @map("display_order")
  slideDuration       Int      @default(10) @map("slide_duration")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([isActive, displayOrder, id], map: "idx_hero_slides_active_order")
  @@index([slideType, projectId], map: "idx_hero_slides_slide_type_project")
  @@map("hero_slides")
}

model SiteAd {
  id              Int       @id @default(autoincrement())
  title           String
  imageUrl        String?   @map("image_url") @db.Text
  targetUrl       String?   @map("target_url") @db.Text
  position        String
  isActive        Boolean   @default(true) @map("is_active")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  mediaType       String    @default("image") @map("media_type")
  mediaUrl        String?   @map("media_url") @db.Text
  clickUrl        String?   @map("click_url") @db.Text
  displayOrder    Int       @default(0) @map("display_order")
  repeatCount     Int       @default(3) @map("repeat_count")
  rotationOrder   Int       @default(0) @map("rotation_order")
  displayDuration Int       @default(30) @map("display_duration")
  widthPx         Int       @default(180) @map("width_px")
  heightPx        Int       @default(320) @map("height_px")
  objectFit       String    @default("cover") @map("object_fit")
  clickCount      Int       @default(0) @map("click_count")
  viewCount       Int       @default(0) @map("view_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([position, displayOrder], map: "idx_site_ads_position_order")
  @@index([rotationOrder, createdAt], map: "idx_site_ads_rotation_order_created")
  @@index([isActive, startDate, endDate], map: "idx_site_ads_active_dates")
  @@map("site_ads")
}

model SiteSettings {
  id               Int      @id @default(1)

  showBaki         Boolean  @default(true) @map("show_baki")
  showSumqayit     Boolean  @default(true) @map("show_sumqayit")
  showAbsheron     Boolean  @default(true) @map("show_absheron")

  showMetroFilter  Boolean  @default(true) @map("show_metro")
  showRayonFilter  Boolean  @default(true) @map("show_rayon")
  showQesebeFilter Boolean  @default(true) @map("show_qesebe")

  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum Role {
  admin
  user
}

enum MediaType {
  image
  video
}
