# Supabase Transaction Pooler connection string for Prisma.
# Use port 6543 and keep both query parameters to avoid prepared statement conflicts.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

NODE_ENV="development"
PORT=3000
JWT_SECRET="change-this-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins for CORS in production, e.g. https://besthome.az,https://www.besthome.az
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="uploads"

# Supabase Storage REST API credentials. Service role key is required only on the backend.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"
SUPABASE_CV_BUCKET="career-cv"
SUPABASE_LISTINGS_BUCKET="elanlar"
SUPABASE_GALLERY_BUCKET="gallery"
SUPABASE_ADS_BUCKET="reklamlar"
MAX_LISTING_IMAGES="20"
MAX_LISTING_IMAGE_SIZE_BYTES="15728640"

# Auth links and email delivery. EMAIL_PROVIDER can be smtp, resend, sendgrid, or mailgun.
PUBLIC_APP_URL="https://besthome.onrender.com"
LISTING_NOTIFY_EMAIL="your-listing-mail@example.com"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="Best Home <noreply@besthome.az>"
EMAIL_FROM_NAME="Best Home"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="[SMTP-USER]"
SMTP_PASS="[SMTP-APP-PASSWORD]"
RESEND_API_KEY="[RESEND-API-KEY]"
SENDGRID_API_KEY="[SENDGRID-API-KEY]"
MAILGUN_API_KEY="[MAILGUN-API-KEY]"
MAILGUN_DOMAIN="mg.besthome.az"


# Mapbox Geocoding API for primary Azerbaijan/Baku address autocomplete.
MAPBOX_ACCESS_TOKEN="[MAPBOX-ACCESS-TOKEN]"

# Optional legacy Google Maps JavaScript API key.
GOOGLE_MAPS_API_KEY="[GOOGLE-MAPS-API-KEY]"

# Google OAuth 2.0 login.
GOOGLE_CLIENT_ID="[GOOGLE-CLIENT-ID]"
GOOGLE_CLIENT_SECRET="[GOOGLE-CLIENT-SECRET]"
GOOGLE_REDIRECT_URI="https://besthome.onrender.com/api/auth/google/callback"

# Optional Google reCAPTCHA protection for login, registration, and forgot password.
# When RECAPTCHA_SECRET_KEY is set, clients must send recaptchaToken, recaptcha_token, or g-recaptcha-response.
RECAPTCHA_SECRET_KEY="[RECAPTCHA-SECRET-KEY]"
RECAPTCHA_MIN_SCORE="0.5"
