# Supabase Transaction Pooler connection string for Prisma.
# Use port 6543 and keep both query parameters to avoid prepared statement conflicts.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

NODE_ENV="development"
PORT=3000
JWT_SECRET="change-this-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins for CORS in production, e.g. https://besthome.az,https://www.besthome.az
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="uploads"
