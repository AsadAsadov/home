<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikTok Data Recycler Pro</title>
    <style>
        :root { --bg: #0a0a0a; --card: #161616; --text: #ececec; --accent: #ff0050; --secondary: #00f2ea; }
        body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', sans-serif; margin: 0; padding: 20px; font-size: 12px; }
        .container { max-width: 1100px; margin: auto; }
        
        /* Naviqasiya */
        .header { background: var(--card); padding: 15px; border-radius: 12px; border: 1px solid #333; display: flex; gap: 10px; margin-bottom: 20px; }
        input { background: #222; border: 1px solid #444; color: white; padding: 8px 12px; border-radius: 6px; flex: 1; outline: none; }
        .btn { padding: 8px 16px; border-radius: 6px; border: none; cursor: pointer; font-weight: bold; transition: 0.2s; }
        .btn-analyze { background: var(--accent); color: white; }
        .btn-trend { background: var(--secondary); color: black; }
        .btn:hover { opacity: 0.8; transform: translateY(-1px); }

        /* Grid Layout */
        .main-grid { display: grid; grid-template-columns: 1.8fr 1.2fr; gap: 20px; }
        .section-header { font-size: 13px; color: #777; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 1px; }

        /* Video Kartları */
        .v-card { background: var(--card); border: 1px solid #222; padding: 12px; border-radius: 8px; margin-bottom: 10px; }
        .v-title { font-weight: 600; margin-bottom: 6px; color: #fff; line-height: 1.4; }
        .v-stats { color: var(--accent); font-weight: bold; font-size: 11px; }
        .v-meta { display: flex; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #333; color: #888; font-size: 10px; }
        .v-music { color: var(--secondary); font-style: italic; }

        /* Trend Kartları */
        .t-card { background: var(--card); border: 1px solid #222; padding: 10px; border-radius: 8px; display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
        .t-img { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--accent); }
        .t-info { flex: 1; }
        .t-reason { color: var(--secondary); font-size: 9px; margin-top: 2px; }
        .t-growth { background: #222; color: var(--accent); padding: 4px 8px; border-radius: 4px; font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <input type="text" id="userInp" placeholder="TikTok istifadəçi adı...">
        <button class="btn btn-analyze" onclick="location.href='/analyze/'+document.getElementById('userInp').value">ANALİZ ET</button>
        <button class="btn btn-trend" onclick="location.href='/fetch-global-trends'">TRENDLƏRİ ÇƏK</button>
    </div>

    <div class="main-grid">
        <section>
            <div class="section-header">🔍 SON ANALİZLƏR</div>
            <% videos.forEach(v => { %>
                <div class="v-card">
                    <div class="v-title"><%= v.caption || "Açıqlama yoxdur" %></div>
                    <div class="v-stats">📈 <%= (v.view_count/1000).toFixed(1) %>K baxış</div>
                    <div class="v-meta">
                        <span>📅 <%= new Date(v.created_at).toLocaleDateString('az-AZ') %></span>
                        <span class="v-music">🎵 <%= v.music_name %></span>
                        <span>👤 @<%= v.accounts?.username %></span>
                    </div>
                </div>
            <% }) %>
        </section>

        <section>
            <div class="section-header">🔥 TREND MUSİQİLƏR</div>
            <% trends.forEach(t => { %>
                <div class="t-card">
                    <img src="<%= t.thumbnail %>" class="t-img">
                    <div class="t-info">
                        <div style="font-weight: bold;"><%= t.trend_name %></div>
                        <div class="t-reason">💡 <%= t.trend_reason %></div>
                    </div>
                    <div class="t-growth">+<%= t.growth_rate %>%</div>
                </div>
            <% }) %>
        </section>
    </div>
</div>

</body>
</html>
