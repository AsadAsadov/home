# Supabase PostgreSQL connection (Project Settings > Database > Connection string > URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

NODE_ENV="development"
PORT=3000
JWT_SECRET="change-this-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins for CORS in production, e.g. https://besthome.az,https://www.besthome.az
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="uploads"
