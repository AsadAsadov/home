generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id             Int      @id @default(autoincrement())
  title          String
  category       String?
  deliveryDate   String?  @map("delivery_date")
  floorCount     String?  @map("floor_count")
  area           String?
  apartmentCount String?  @map("apartment_count")
  repairStatus   String?  @map("repair_status")
  features       String?
  description    String?  @db.Text
  imageUrl       String?  @map("image_url") @db.Text
  images         Json?
  displayOrder   Int?     @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([displayOrder, id])
  @@map("projects")
}

model Listing {
  id               BigInt         @id @default(autoincrement())
  title            String
  listingType      String?        @map("listing_type")
  propertyCategory String?        @map("property_category")
  projectName      String?        @map("project_name")
  roomCount        Int?           @map("room_count")
  area             String?
  floorNumber      Int?           @map("floor_number")
  floorCount       String?        @map("floor_count")
  price            Decimal?       @db.Decimal(14, 2)
  pricePerM2       Decimal?       @map("price_per_m2") @db.Decimal(12, 2)
  imageUrl         String?        @map("image_url") @db.Text
  description      String?        @db.Text
  displayOrder     Int?           @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  userId           BigInt?        @map("user_id")
  status           String         @default("pending")
  approvedAt       DateTime?      @map("approved_at")
  approvedBy       BigInt?        @map("approved_by")
  viewCount        Int            @default(0) @map("view_count")
  favoritesCount   Int            @default(0) @map("favorites_count")
  featured         Boolean        @default(false)
  vip              Boolean        @default(false)
  images           ListingImage[]
  views            ListingView[]
  favorites        Favorite[]

  @@index([displayOrder, id])
  @@index([status], map: "idx_listings_status")
  @@map("listings")
}

model ListingView {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  userId    BigInt?  @map("user_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId], map: "idx_listing_views_listing_id")
  @@index([viewedAt], map: "idx_listing_views_viewed_at")
  @@map("listing_views")
}

model Favorite {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  listingId BigInt   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId], map: "idx_favorites_user_id")
  @@index([listingId], map: "idx_favorites_listing_id")
  @@map("favorites")
}

model ListingImage {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  imageUrl  String   @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model Vacancy {
  id             Int           @id @default(autoincrement())
  title          String
  employmentType String?       @map("employment_type")
  salary         String?
  city           String?
  description    String?       @db.Text
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  applications   Application[]

  @@map("vacancies")
}

model Application {
  id        Int      @id @default(autoincrement())
  fullname  String
  phone     String?
  vacancyId Int?     @map("vacancy_id")
  cvFile    String?  @map("cv_file") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@map("applications")
}

model Gallery {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?   @db.Text
  mediaType    MediaType @map("media_type")
  imageUrl     String?   @map("image_url") @db.Text
  videoUrl     String?   @map("video_url") @db.Text
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  mediaUrls    Json?     @map("media_urls")
  images       Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("gallery")
}

model User {
  id           Int      @id @default(autoincrement())
  fullname     String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?  @db.Text
  role         Role     @default(user)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model HeroSection {
  id               String   @id @default(uuid()) @db.Uuid
  pageKey          String   @unique @map("page_key")
  badgeText        String?  @map("badge_text")
  title            String?
  description      String?  @db.Text
  heroImageUrl     String?  @map("hero_image_url") @db.Text
  badgeColor       String?  @default("#7F7FFF") @map("badge_color")
  titleColor       String?  @default("#111827") @map("title_color")
  descriptionColor String?  @default("#374151") @map("description_color")
  overlayColor     String?  @default("#000000") @map("overlay_color")
  overlayOpacity   Decimal? @default(0.35) @map("overlay_opacity") @db.Decimal(3, 2)
  buttonColor      String?  @default("#7F7FFF") @map("button_color")
  buttonTextColor  String?  @default("#FFFFFF") @map("button_text_color")
  isActive         Boolean  @default(true) @map("is_active")

  @@map("hero_sections")
}

enum Role {
  admin
  user
}

enum MediaType {
  image
  video
}
