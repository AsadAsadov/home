<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>TikTok Music Strategist Pro</title>
    <style>
        :root { --bg: #080808; --card: #121212; --accent: #ff0050; --secondary: #00f2ea; --text: #e0e0e0; }
        body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; margin: 0; padding: 20px; font-size: 12px; }
        .container { max-width: 1200px; margin: auto; }
        .header { background: var(--card); padding: 15px; border-radius: 12px; border: 1px solid #222; display: flex; gap: 10px; margin-bottom: 25px; }
        input { background: #1a1a1a; border: 1px solid #333; color: white; padding: 10px 15px; border-radius: 8px; flex: 1; outline: none; }
        .btn { padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer; font-weight: bold; }
        .btn-analyze { background: var(--accent); color: white; }
        .btn-trend { background: var(--secondary); color: black; }
        .main-grid { display: grid; grid-template-columns: 1.8fr 1.2fr; gap: 20px; }
        .v-card { background: var(--card); border: 1px solid #222; padding: 15px; border-radius: 12px; margin-bottom: 15px; }
        .stat-badge { padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; background: rgba(255,255,255,0.05); }
        .t-card { background: var(--card); border: 1px solid #222; padding: 12px; border-radius: 12px; display: flex; align-items: center; gap: 12px; cursor: pointer; margin-bottom: 10px; }
        .t-img { width: 45px; height: 45px; border-radius: 8px; object-fit: cover; }
        .modal-overlay { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); z-index:99; }
        #musicModal { display: none; position: fixed; top:50%; left:50%; transform:translate(-50%, -50%); width:90%; max-width:500px; background:#181818; border:1px solid var(--secondary); border-radius:16px; padding:20px; z-index:100; max-height: 80vh; overflow-y: auto; }
        .modal-item { background:#222; padding:12px; border-radius:10px; margin-bottom:12px; border-left: 3px solid var(--accent); }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <input type="text" id="userInp" placeholder="TikTok istifadəçi adı...">
        <button class="btn btn-analyze" onclick="location.href='/analyze/'+document.getElementById('userInp').value">PROFİLİ ANALİZ ET</button>
        <button class="btn btn-trend" onclick="location.href='/fetch-global-trends'">KƏŞFİYYATI (DISCOVER) ÇƏK</button>
    </div>

    <div class="main-grid">
        <section>
            <h3>🔍 Son Analizlər</h3>
            <% videos.forEach(v => { %>
                <div class="v-card">
                    <a href="<%= v.video_url %>" target="_blank" style="color:white; text-decoration:none; font-weight:600;"><%= v.caption %> ↗</a>
                    <div style="margin-top:10px; display:flex; gap:10px;">
                        <span class="stat-badge" style="color:var(--accent)">👁 <%= v.view_count %></span>
                        <span class="stat-badge" style="color:var(--secondary)">❤️ <%= v.like_count %></span>
                        <span class="stat-badge">🎵 <%= v.music_name %></span>
                    </div>
                </div>
            <% }) %>
        </section>

        <section>
            <h3>🔥 Kəşfiyyat Trendləri</h3>
            <% trends.forEach(t => { %>
                <div class="t-card" onclick="showMusic('<%= t.trend_id %>', '<%= t.trend_name %>')">
                    <img src="<%= t.thumbnail %>" class="t-img" onerror="this.src='https://www.tiktok.com/favicon.ico'">
                    <div style="flex:1">
                        <div style="font-weight: bold;"><%= t.trend_name %></div>
                        <div style="font-size:10px; color:#666">Potensial: <%= t.growth_rate %>%</div>
                    </div>
                    <div style="color:var(--accent); font-size:10px;"><%= t.trend_reason %></div>
                </div>
            <% }) %>
        </section>
    </div>
</div>

<div class="modal-overlay" onclick="closeM()"></div>
<div id="musicModal">
    <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom:15px;">
        <b id="mTitle" style="color:var(--secondary);">Analiz</b>
        <button onclick="closeM()" style="background:none; border:none; color:var(--accent); cursor:pointer;">BAĞLA</button>
    </div>
    <div id="mList"></div>
</div>

<script>
    async function showMusic(id, name) {
        document.querySelector('.modal-overlay').style.display = 'block';
        document.getElementById('musicModal').style.display = 'block';
        document.getElementById('mTitle').innerText = name;
        const list = document.getElementById('mList');
        list.innerHTML = "<p style='text-align:center;'>Kəşfiyyat datası emal olunur...</p>";

        try {
            const res = await fetch('/music-trends/' + id);
            const data = await res.json();
            list.innerHTML = data.map(v => `
                <div class="modal-item">
                    <div style="font-size:11px; margin-bottom:5px;">${v.title}</div>
                    <div style="color:var(--accent); font-weight:bold; font-size:10px;">👁 ${v.play_count}</div>
                    <a href="${v.link}" target="_blank" style="color:var(--secondary); font-size:10px; text-decoration:none;">VİDEOYA GET ↗</a>
                </div>
            `).join('');
        } catch (e) { list.innerHTML = "Məlumat tapılmadı."; }
    }
    function closeM() {
        document.querySelector('.modal-overlay').style.display = 'none';
        document.getElementById('musicModal').style.display = 'none';
    }
</script>

</body>
</html>
