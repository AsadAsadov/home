<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>TikTok Trend Detector</title>
    <style>
        body { background: #0a0a0a; color: #e0e0e0; font-family: 'Segoe UI', sans-serif; font-size: 11px; margin: 0; padding: 15px; }
        .header { display: flex; gap: 10px; margin-bottom: 20px; background: #111; padding: 15px; border-radius: 8px; border: 1px solid #222; }
        input { background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 4px; width: 200px; font-size: 11px; }
        .btn { background: #ff0050; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn-discover { background: #00f2ea; color: #000; }
        
        .grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; }
        .section-title { font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: #888; margin-bottom: 15px; display: flex; align-items: center; gap: 5px; }
        
        .card { background: #141414; border: 1px solid #222; padding: 10px; border-radius: 6px; margin-bottom: 8px; transition: 0.3s; }
        .card:hover { border-color: #444; background: #1a1a1a; }
        
        .trend-item { display: flex; gap: 10px; align-items: center; }
        .trend-img { width: 40px; height: 40px; border-radius: 4px; object-fit: cover; }
        .reason { color: #00f2ea; font-weight: bold; margin-top: 4px; font-size: 10px; }
        .growth { color: #ff0050; font-size: 12px; font-weight: bold; }
        .stats-row { color: #666; margin-top: 5px; }
    </style>
</head>
<body>

    <div class="header">
        <input type="text" id="userInput" placeholder="Profil adı (məs: khaby.lame)">
        <button class="btn" onclick="location.href='/analyze/'+document.getElementById('userInput').value">PROFİL ANALİZ</button>
        <button class="btn btn-discover" onclick="location.href='/fetch-global-trends'">KƏŞF ET (GLOBAL TRENDS)</button>
    </div>

    <div class="grid">
        <div>
            <div class="section-title">🎬 SON ANALİZ OLUNAN VİDEOLAR</div>
            <% videos.forEach(v => { %>
                <div class="card">
                    <div style="font-weight: bold; margin-bottom: 4px;"><%= v.caption.substring(0, 60) %>...</div>
                    <div class="stats-row">
                        👁 <%= (v.view_count/1000).toFixed(1) %>K | ❤️ <%= v.like_count %> | 👤 @<%= v.accounts?.username %>
                    </div>
                </div>
            <% }) %>
        </div>

        <div>
            <div class="section-title">📈 TREND POTENSİALI (AĞILLI ANALİZ)</div>
            <% trends.forEach(t => { %>
                <div class="card">
                    <div class="trend-item">
                        <img src="<%= t.thumbnail %>" class="trend-img">
                        <div style="flex: 1;">
                            <div style="font-weight: bold;"><%= t.trend_name %></div>
                            <div class="reason">💡 <%= t.trend_reason %></div>
                        </div>
                        <div class="growth">+<%= t.growth_rate %>%</div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

</body>
</html>
