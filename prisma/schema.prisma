generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id             Int      @id @default(autoincrement())
  title          String
  category       String?
  deliveryDate   String?  @map("delivery_date")
  floorCount     String?  @map("floor_count")
  area           String?
  apartmentCount String?  @map("apartment_count")
  repairStatus   String?  @map("repair_status")
  features       String?
  description    String?  @db.Text
  imageUrl       String?  @map("image_url") @db.Text
  images         Json?
  displayOrder   Int?     @map("display_order")
  slug           String?  @unique
  featuredInHero Boolean  @default(false) @map("featured_in_hero")
  createdAt      DateTime @default(now()) @map("created_at")
  heroSlides     HeroSlide[]

  @@index([displayOrder, id])
  @@map("projects")
}

model Listing {
  id               BigInt         @id @default(autoincrement())
  title            String
  listingType      String?        @map("listing_type")
  propertyCategory String?        @map("property_category")
  projectName      String?        @map("project_name")
  regionType       String?        @map("region_type")
  city             String?
  district         String?
  neighborhood     String?
  roomCount        Int?           @map("room_count")
  area             String?
  floorNumber      Int?           @map("floor_number")
  floorCount       String?        @map("floor_count")
  price            Decimal?       @db.Decimal(14, 2)
  pricePerM2       Decimal?       @map("price_per_m2") @db.Decimal(12, 2)
  currency         String         @default("AZN")
  isCredit         Boolean        @default(false) @map("is_credit")
  creditDownPayment Decimal?      @map("credit_down_payment") @db.Decimal(14, 2)
  creditMonthlyPayment Decimal?   @map("credit_monthly_payment") @db.Decimal(14, 2)
  creditYears      Int?           @map("credit_years")
  imageUrl         String?        @map("image_url") @db.Text
  description      String?        @db.Text
  displayOrder     Int?           @map("display_order")
  listingCode      Int?           @unique @map("listing_code")
  createdAt        DateTime       @default(now()) @map("created_at")
  userId           BigInt?        @map("user_id")
  status           String         @default("pending")
  approvedAt       DateTime?      @map("approved_at")
  approvedBy       BigInt?        @map("approved_by")
  viewCount        Int            @default(0) @map("view_count")
  favoritesCount   Int            @default(0) @map("favorites_count")
  featured         Boolean        @default(false)
  vip              Boolean        @default(false)
  images           ListingImage[]
  views            ListingView[]
  favorites        Favorite[]

  @@index([displayOrder, id])
  @@index([status], map: "idx_listings_status")
  @@map("listings")
}

model ListingView {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  userId    BigInt?  @map("user_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId], map: "idx_listing_views_listing_id")
  @@index([viewedAt], map: "idx_listing_views_viewed_at")
  @@map("listing_views")
}

model Favorite {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  listingId BigInt   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId], map: "idx_favorites_user_id")
  @@index([listingId], map: "idx_favorites_listing_id")
  @@map("favorites")
}

model ListingImage {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  imageUrl  String   @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model Vacancy {
  id             Int           @id @default(autoincrement())
  title          String
  employmentType String?       @map("employment_type")
  salary         String?
  city           String?
  description    String?       @db.Text
  isActive       Boolean       @default(true) @map("is_active")
  slug           String?       @unique
  createdAt      DateTime      @default(now()) @map("created_at")
  applications   Application[]

  @@map("vacancies")
}

model Application {
  id        Int      @id @default(autoincrement())
  fullname  String
  phone     String?
  vacancyId Int?     @map("vacancy_id")
  cvFile    String?  @map("cv_file") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@map("applications")
}

model Gallery {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?   @db.Text
  mediaType    MediaType @map("media_type")
  imageUrl     String?   @map("image_url") @db.Text
  videoUrl     String?   @map("video_url") @db.Text
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  mediaUrls    Json?     @map("media_urls")
  images       Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("gallery")
}

model User {
  id            Int               @id @default(autoincrement())
  fullname      String
  email         String            @unique
  passwordHash  String            @map("password_hash")
  phone         String?           @db.Text
  avatarUrl     String?           @map("avatar_url") @db.Text
  bio           String?           @db.Text
  isActive      Boolean           @default(true) @map("is_active")
  emailVerified Boolean           @default(false) @map("email_verified")
  phoneVerified Boolean           @default(false) @map("phone_verified")
  lastLogin     DateTime?         @map("last_login")
  role          Role              @default(user)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")
  sessions      UserSession[]
  activityLogs  UserActivityLog[]

  @@map("users")
}

model UserSession {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.Text
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([expiresAt], map: "idx_user_sessions_expires_at")
  @@map("user_sessions")
}

model UserActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_activity_logs_user_id")
  @@index([action], map: "idx_user_activity_logs_action")
  @@index([createdAt], map: "idx_user_activity_logs_created_at")
  @@map("user_activity_logs")
}

model HeroSection {
  id               String   @id @default(uuid()) @db.Uuid
  pageKey          String   @unique @map("page_key")
  badgeText        String?  @map("badge_text")
  title            String?
  description      String?  @db.Text
  heroImageUrl     String?  @map("hero_image_url") @db.Text
  badgeColor       String?  @default("#7F7FFF") @map("badge_color")
  titleColor       String?  @default("#111827") @map("title_color")
  descriptionColor String?  @default("#374151") @map("description_color")
  overlayColor     String?  @default("#000000") @map("overlay_color")
  overlayOpacity   Decimal? @default(0.35) @map("overlay_opacity") @db.Decimal(3, 2)
  buttonColor      String?  @default("#7F7FFF") @map("button_color")
  buttonTextColor  String?  @default("#FFFFFF") @map("button_text_color")
  isActive         Boolean  @default(true) @map("is_active")

  @@map("hero_sections")
}

model HeroSlide {
  id                    Int      @id @default(autoincrement())
  title                 String
  description           String?  @db.Text
  slideType             String   @default("custom") @map("slide_type")
  projectId             Int?     @map("project_id")
  mediaType             String   @default("image") @map("media_type")
  mediaUrl              String   @map("media_url") @db.Text
  badgeText             String?  @map("badge_text")
  badgeColor            String?  @default("#FFFFFF") @map("badge_color")
  badgeBackground       String?  @default("rgba(127,127,255,0.92)") @map("badge_background")
  titleColor            String?  @default("#FFFFFF") @map("title_color")
  titleFontSize         Int      @default(48) @map("title_font_size")
  descriptionColor      String?  @default("#F8FAFC") @map("description_color")
  descriptionFontSize   Int      @default(18) @map("description_font_size")
  buttonColor           String?  @default("#7F7FFF") @map("button_color")
  buttonTextColor       String?  @default("#FFFFFF") @map("button_text_color")
  panelBackground       String?  @default("#111827") @map("panel_background")
  panelBlur             Int      @default(18) @map("panel_blur")
  panelOpacity          Int      @default(72) @map("panel_opacity")
  panelPosition         String   @default("bottom-center") @map("panel_position")
  heroHeightDesktop     Int      @default(560) @map("hero_height_desktop")
  heroHeightTablet      Int      @default(420) @map("hero_height_tablet")
  heroHeightMobile      Int      @default(320) @map("hero_height_mobile")
  buttonText            String?  @map("button_text")
  buttonLink            String?  @map("button_link") @db.Text
  displayOrder          Int      @default(0) @map("display_order")
  slideDuration         Int      @default(10) @map("slide_duration")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  project               Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([isActive, displayOrder, id], map: "idx_hero_slides_active_order")
  @@index([slideType, projectId], map: "idx_hero_slides_slide_type_project")
  @@map("hero_slides")
}

model SiteAd {
  id              Int       @id @default(autoincrement())
  title           String
  imageUrl        String?   @map("image_url") @db.Text
  targetUrl       String?   @map("target_url") @db.Text
  position        String
  isActive        Boolean   @default(true) @map("is_active")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  mediaType       String    @default("image") @map("media_type")
  mediaUrl        String?   @map("media_url") @db.Text
  clickUrl        String?   @map("click_url") @db.Text
  displayOrder    Int       @default(0) @map("display_order")
  repeatCount     Int       @default(3) @map("repeat_count")
  rotationOrder   Int       @default(0) @map("rotation_order")
  displayDuration Int       @default(30) @map("display_duration")
  widthPx         Int       @default(180) @map("width_px")
  heightPx        Int       @default(320) @map("height_px")
  objectFit       String    @default("cover") @map("object_fit")
  clickCount      Int       @default(0) @map("click_count")
  viewCount       Int       @default(0) @map("view_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([position, displayOrder], map: "idx_site_ads_position_order")
  @@index([rotationOrder, createdAt], map: "idx_site_ads_rotation_order_created")
  @@index([isActive, startDate, endDate], map: "idx_site_ads_active_dates")
  @@map("site_ads")
}

enum Role {
  admin
  user
}

enum MediaType {
  image
  video
}
